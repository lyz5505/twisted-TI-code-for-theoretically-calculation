22919dad5bf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"translation21", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"-", "bb2"}], "+", 
       RowBox[{"G", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "one12", ",", "zero12"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
