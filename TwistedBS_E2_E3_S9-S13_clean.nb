Cell[CellGroupData[{

Cell["6. E3: Original Wilson Loop and Wannier-Center Flow", "Section",ExpressionUUID->"2fe22fb2-23f4-4e42-92ec-0bc7455d70cb"],

Cell["\<\
The original INTDOT, Tran2, and WTPBUT calculations are retained, without SVD \
unitarization. The original grid uses num=100 and num2=200 and can take \
substantial time.\
\>", "Text",ExpressionUUID->"9d6a46aa-6988-c040-aacc-1d09db77452d"],

