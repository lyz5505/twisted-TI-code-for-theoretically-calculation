\>", "Text",ExpressionUUID->"27427249-990c-6c47-aef9-3d08e911c7c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TA", "=", 
   RowBox[{"1", " ", "Degree"}]}], ";", 
  RowBox[{"bb1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b1"}], "*", "TA"}]}], ";", 
  RowBox[{"bb2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b2"}], "*", "TA"}]}], ";", 
  RowBox[{"bb3", "=", 
   RowBox[{
    RowBox[{"RotationMatrix", "[", 
     RowBox[{"2", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb1"}]}], ";", 
  RowBox[{"bb4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb3"}], "//", "Chop"}]}], ";", 
  RowBox[{"bb5", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb4"}], "//", "Chop"}]}], ";", 
  RowBox[{"bb6", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb5"}], "//", "Chop"}]}], ";", 
  RowBox[{"n", "=", "moireShell"}], ";", 
  RowBox[{"Glength", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"2", "n"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"2", "n"}], ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Gbegin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "@", 
       RowBox[{"Glength", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "i"}], "]"}], "]"}]}], "-", 
      RowBox[{"Glength", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Glength", "]"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"G", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "i"}], ")"}], "bb5"}], "+", 
          RowBox[{"j", " ", "bb4"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "i"}], ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     ",", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "i"}], ")"}], "bb5"}], "+", 
          RowBox[{"j", " ", "bb4"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "n"}], ",", 
           RowBox[{"n", "-", "i"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{"Graphics", "[", 
   RowBox[{"Point", "[", "G", "]"}], "]"}]}]], "Input",
