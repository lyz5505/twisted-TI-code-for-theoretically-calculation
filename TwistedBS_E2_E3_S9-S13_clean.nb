 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"theta31", "=", "1.`"}], ";", 
  RowBox[{"moireShell", "=", "5"}], ";"}]], "Input",
 CellTags->"AssemblyAddition",
 CellLabel->"In[11]:=",ExpressionUUID->"f3ff8a57-f51c-bb48-b80a-9946dbed643c"],

