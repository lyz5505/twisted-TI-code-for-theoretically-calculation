Cell[BoxData[
 RowBox[{"DimH", "=", 
  RowBox[{
   RowBox[{"Dimensions", "[", 
    RowBox[{"Hallcp", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", "mu", ",", "mu"}], 
     "]"}], "]"}], "[", 
