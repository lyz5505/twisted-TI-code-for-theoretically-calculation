         RowBox[{"2", "n"}], ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Gbegin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "@", 
