Cell[BoxData[
 RowBox[{
  RowBox[{"num2", "=", "200"}], ";", 
  RowBox[{
   RowBox[{"INTDOT", "[", "k_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Im", "[", 
     RowBox[{"Chop", "@", 
      RowBox[{"Log", "[", 
       RowBox[{"Chop", "@", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"Apply", "[", 
          RowBox[{"Dot", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", 
              RowBox[{"Transpose", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "num2"}], "}"}]}], "]"}]}], "]"}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "Pi"}], ")"}]}]}], ";", 
  RowBox[{"Irange", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}]}],
   ";", 
  RowBox[{
   RowBox[{"WTPBUT", "[", "a_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"EigPB", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "/", "num"}], " ", "B1"}], "+", 
           RowBox[{
            RowBox[{"i", "/", "num2"}], " ", "B2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"INTDOT", "[", 
      RowBox[{"Append", "[", 
       RowBox[{"t", ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Tran2", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"t", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "unfold +Z2 change potential.nb", "OriginalInputIndex" -> 
   271, "EditNote" -> ""|>,
 CellTags->
  "Source:potential:271",ExpressionUUID->"78fd8ff4-4c5a-4e4a-80a6-\
496926c6dd08"],

