 RowBox[{"Totalp", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "15"}], "}"}]}], "]"}]}]], "Input",
