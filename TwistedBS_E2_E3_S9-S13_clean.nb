Cell[BoxData[
 RowBox[{
  RowBox[{"Hallint", "=", 
   RowBox[{"ArrayFlatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"H3diag", "[", 
          RowBox[{"{", 
           RowBox[{"kx", ",", "ky"}], "}"}], "]"}], "+", 
         RowBox[{"lm", " ", "HoffmoireC3"}]}], ",", 
        RowBox[{"lm", " ", "Hoffmoire"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"lm", " ", 
         RowBox[{"Conjugate", "@", 
          RowBox[{"Transpose", "@", "Hoffmoire"}]}]}], ",", 
        RowBox[{
         RowBox[{"H1diag", "[", 
          RowBox[{"{", 
           RowBox[{"kx", ",", "ky"}], "}"}], "]"}], "+", 
         RowBox[{"lm", " ", "HoffmoireC1"}]}]}], "}"}]}], "}"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Hall", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kxx_", ",", "kyy_"}], "}"}], ",", "lmm_", ",", "mu_"}], "]"}], 
   ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"N", "@", 
       RowBox[{"Chop", "@", "Hallint"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"kx", "->", "kxx"}], ",", 
