Cell[BoxData[
 RowBox[{
  RowBox[{"Gap", "[", "mu_", "]"}], ":=", 
  RowBox[{"Apply", "[", 
   RowBox[{"Subtract", ",", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Hallcp", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", "mu", ",", "mu"}], 
         "]"}], "+", 
        RowBox[{"1000", " ", 
         RowBox[{"IdentityMatrix", "[", "DimH", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"DimH", "/", "2"}], "+", "2"}], ",", 
         RowBox[{
          RowBox[{"DimH", "/", "2"}], "+", "3"}]}], "}"}]}], "]"}], "-", 
     "1000"}]}], "]"}]}]], "Input",
 TaggingRules-><|
