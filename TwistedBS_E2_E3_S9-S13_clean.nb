     RowBox[{"Hallcp", "[", 
      RowBox[{"k", ",", "1", ",", "mu", ",", "mu"}], "]"}], "+", 
     RowBox[{"1000", " ", 
      RowBox[{"IdentityMatrix", "[", "DimH", "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"DimH", "/", "2"}], "+", "1"}], ",", 
      RowBox[{
       RowBox[{"DimH", "/", "2"}], "+", "2"}]}], "}"}]}], "]"}]}]], "Input",
