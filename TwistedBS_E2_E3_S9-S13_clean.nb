  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", ">", "0"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"x", "-", "0.1"}], ",", "x"}], "}"}]}], "]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "x", ",", 
         RowBox[{"x", "+", "0.1"}]}], "}"}]}], "]"}]}], "]"}], "/", 
   "Totalp"}]}]], "Input",
