  RowBox[{"Select2", "[", 
   RowBox[{"{", 
    RowBox[{"a_", ",", "b_"}], "}"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{"a", " ", "b1"}], " ", "+", " ", 
       RowBox[{"b", " ", "b2"}]}], "]"}], "<=", 
     RowBox[{"Norm", "[", 
      RowBox[{"b1", "+", "b2"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", "Null"}], "]"}]}]], "Input",
