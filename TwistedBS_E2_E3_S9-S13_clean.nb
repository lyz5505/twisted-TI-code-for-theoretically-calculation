Cell[BoxData[
 RowBox[{
  RowBox[{"TA", "=", 
   RowBox[{"theta31", " ", "Degree"}]}], ";", 
  RowBox[{"bb1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b1"}], "*", "TA"}]}], ";", 
  RowBox[{"bb2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b2"}], "*", "TA"}]}], ";", 
  RowBox[{"bb3", "=", 
   RowBox[{
    RowBox[{"RotationMatrix", "[", 
     RowBox[{"2", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb1"}]}], ";", 
  RowBox[{"bb4", "=", 
