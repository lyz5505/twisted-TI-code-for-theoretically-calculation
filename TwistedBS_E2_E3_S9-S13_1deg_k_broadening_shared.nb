Cell[BoxData[
 RowBox[{
  RowBox[{"off", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Total", "@", "Glength"}], ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "13"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"G", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "-", 
           RowBox[{
