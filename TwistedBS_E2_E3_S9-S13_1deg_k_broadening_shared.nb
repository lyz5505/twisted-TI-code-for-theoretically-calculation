Cell["\<\
Compute all layer projections together; diagonalize each sampled momentum \
only once.\
\>", "Text",ExpressionUUID->"ab91492a-e51b-0f45-92b6-4f235c9bb8bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "unfoldedSpectrumAtKWithKBroadeningMulti", ",", 
    "unfoldedSpectralDataKBroadeningMulti"}], "]"}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectrumAtKWithKBroadeningMulti", "[", 
    RowBox[{
    "kExt_", ",", "hFun_", ",", "eGrid_", ",", "etaE_", ",", "etaK_", ",", 
     "kr_", ",", "kdens_", ",", "blockSpecs_List", ",", "gList_", ",", 
     RowBox[{"nEig_", ":", "All"}], ",", 
     RowBox[{"energyShift_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"samples", ",", "spectra", ",", 
       RowBox[{"normalization", "=", "0.`"}], ",", "fold", ",", "eig", ",", 
       "vals", ",", "vecs", ",", "projectionWeights", ",", "energyKernels", ",",
        "weightK"}], "}"}], ",", 
     RowBox[{
      RowBox[{"samples", "=", 
       RowBox[{"kDiskSamples", "[", 
        RowBox[{"kExt", ",", "kr", ",", "kdens"}], "]"}]}], ";", 
      RowBox[{"spectra", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.`", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "blockSpecs", "]"}], ",", 
           RowBox[{"Length", "[", "eGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"fold", "=", 
          RowBox[{"foldExternalK", "[", 
           RowBox[{"ksamp", ",", "gList"}], "]"}]}], ";", 
         RowBox[{"weightK", "=", 
          RowBox[{"kLorentzianKernel", "[", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"ksamp", "-", "kExt"}], "]"}], ",", "etaK"}], "]"}]}], ";", 
         RowBox[{"normalization", "+=", "weightK"}], ";", 
         RowBox[{"eig", "=", 
          RowBox[{"eigensystemAtFoldedK", "[", 
           RowBox[{"hFun", ",", 
            RowBox[{"fold", "[", "\"\<KFold\>\"", "]"}], ",", "nEig"}], 
           "]"}]}], ";", 
         RowBox[{"vals", "=", 
          RowBox[{"shiftEigenvaluesByHalfFilling", "[", 
           RowBox[{
            RowBox[{
            "eig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
             "energyShift"}], "]"}]}], ";", 
         RowBox[{"vecs", "=", 
          RowBox[{
          "eig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";", 
         RowBox[{"projectionWeights", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"unfoldedWeight", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{"fold", "[", "\"\<GIndex\>\"", "]"}], ",", "spec"}], 
                "]"}], "&"}], ")"}], "/@", "vecs"}], ",", 
            RowBox[{"{", 
             RowBox[{"spec", ",", "blockSpecs"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"energyKernels", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lorentzianKernel", "[", 
                RowBox[{"e", ",", "#1", ",", "etaE"}], "]"}], "&"}], ")"}], "/@",
              "vals"}], ",", 
            RowBox[{"{", 
             RowBox[{"e", ",", "eGrid"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"spectra", "+=", 
          RowBox[{"weightK", " ", 
           RowBox[{"projectionWeights", ".", 
            TemplateBox[{"energyKernels"},
             "Transpose"]}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ksamp", ",", "samples"}], "}"}]}], "]"}], ";", 
      FractionBox["spectra", "normalization"]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectralDataKBroadeningMulti", "[", 
    RowBox[{
    "kExtPath_", ",", "hFun_", ",", "eGrid_", ",", "etaE_", ",", "etaK_", ",",
      "kr_", ",", "kdens_", ",", "projections_Association", ",", "gList_", ",", 
     RowBox[{"nEig_", ":", "All"}], ",", 
     RowBox[{"energyShift_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"externalKPathIndex", "[", "kExtPath", "]"}]}], ",", 
       RowBox[{"specs", "=", 
        RowBox[{"Values", "[", "projections", "]"}]}], ",", "spectra"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"spectra", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"unfoldedSpectrumAtKWithKBroadeningMulti", "[", 
          RowBox[{
          "k", ",", "hFun", ",", "eGrid", ",", "etaE", ",", "etaK", ",", "kr",
            ",", "kdens", ",", "specs", ",", "gList", ",", "nEig", ",", 
           "energyShift"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "kExtPath"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Keys", "[", "projections", "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "x", "\[LeftDoubleBracket]", "ik", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "eGrid", "\[LeftDoubleBracket]", "ie", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"spectra", "\[LeftDoubleBracket]", 
                 RowBox[{"ik", ",", "ip", ",", "ie"}], 
                 "\[RightDoubleBracket]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"ik", ",", 
                RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"ie", ",", 
                RowBox[{"Length", "[", "eGrid", "]"}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ip", ",", 
            RowBox[{"Length", "[", "specs", "]"}]}], "}"}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
