Cell[BoxData[
 RowBox[{
  RowBox[{"HSOC8layerint", "=", 
   RowBox[{
    RowBox[{"slabHamiltonianlayer", "[", 
     RowBox[{"kx", ",", "ky", ",", "paramsStep2diiExtSOC", ",", "8"}], "]"}], 
    "+", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "8", "]"}], ",", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "]"}], 
     "1000000", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["kx", "2"], "+", 
        SuperscriptBox["ky", "2"]}], ")"}], "2"]}]}]}], ";"}]], "Input",
