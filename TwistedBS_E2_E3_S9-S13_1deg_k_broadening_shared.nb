Cell["3. Single-Angle 3+1 Moire Hamiltonian: E2 / S10 / S11", "Section",ExpressionUUID->"aba2a2d4-87c7-d343-b0ff-e46949f1cd99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"HSOC3layerint", "=", 
   RowBox[{
    RowBox[{"HSOC4layer", "[", 
     RowBox[{"{", 
      RowBox[{"kx", ",", "ky"}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "12"}], ",", 
      RowBox[{"1", ";;", "12"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HSOC3layer", "[", 
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], "]"}], ":=", 
   RowBox[{"HSOC3layerint", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kx", "->", "kxx"}], ",", 
      RowBox[{"ky", "->", "kyy"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HSOC1layerint", "=", 
   RowBox[{
    RowBox[{"HSOC4layer", "[", 
     RowBox[{"{", 
      RowBox[{"kx", ",", "ky"}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "4"}], ",", 
      RowBox[{"1", ";;", "4"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HSOC1layer", "[", 
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], "]"}], ":=", 
   RowBox[{"HSOC1layerint", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kx", "->", "kxx"}], ",", 
      RowBox[{"ky", "->", "kyy"}]}], "}"}]}]}], ";", 
  RowBox[{"HNonSOC1layerint", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"slabHamiltonianDD0k2", "[", 
      RowBox[{"kx", ",", "ky", ",", "params4QLNoSOCDD0k2"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", "4"}], ",", 
       RowBox[{"1", ";;", "4"}]}], "]"}], "]"}], "+", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "1000000", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["kx", "2"], "+", 
        SuperscriptBox["ky", "2"]}], ")"}], "2"]}]}]}], ";", 
  RowBox[{
   RowBox[{"HNonSOClayer", "[", 
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], "]"}], ":=", 
