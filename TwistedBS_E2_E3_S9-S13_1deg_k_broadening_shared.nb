Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"translation22", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"-", "bb2"}], "+", 
       RowBox[{"G", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "one4", ",", "zero4"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tran22", "=", 
   RowBox[{"N", "@", 
    RowBox[{"ArrayFlatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"translation22", "[", 
        RowBox[{"i", ",", "k"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
