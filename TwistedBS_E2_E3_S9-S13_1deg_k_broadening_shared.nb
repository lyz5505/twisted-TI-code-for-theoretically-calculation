Cell["\<\
The band plot above retains the original division by 1000, so its energy \
values are in eV. The unfolded spectra below use meV, as in the original code.\
\>", "Text",ExpressionUUID->"d2466e91-9a05-7d40-bed0-27813704ba5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Original Unfolding Functions and Single-Angle 3+1 Spectra", "Section",ExpressionUUID->"2ec2cd8e-b531-c746-9255-0290e2d90be7"],

Cell["\<\
The complete original code_yunzhe_newP4_unfolding.wl is embedded below. The \
unfolding weights and spectral-function formulas are retained.\
\>", "Text",ExpressionUUID->"4a3d7fa9-88b7-7c47-a1a9-6837cd404092"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "sortEigensystemByEnergy", ",", "lorentzianKernel", ",", 
    "kLorentzianKernel", ",", "kDiskSamples", ",", "gSectorIndices", ",", 
    "unfoldedWeight", ",", "externalKPathIndex", ",", "foldExternalK", ",", 
    "foldExternalKPath", ",", "eigensystemAtFoldedK", ",", 
    "unfoldedSpectrumAtAlignedK", ",", "unfoldedSpectralDataAligned", ",", 
    "unfoldedSpectralDensityPlotAligned", ",", 
    "unfoldedSpectrumAtKWithKBroadening", ",", 
    "unfoldedSpectralDataKBroadening", ",", 
    "unfoldedSpectralDensityPlotKBroadening", ",", 
    "shiftEigenvaluesByHalfFilling"}], "]"}], ";", 
  RowBox[{
   RowBox[{"sortEigensystemByEnergy", "[", 
    RowBox[{"{", 
     RowBox[{"vals_", ",", "vecs_"}], "}"}], "]"}], ":=", 
   TemplateBox[{
     RowBox[{"SortBy", "[", 
       RowBox[{
         TemplateBox[{
           RowBox[{"{", 
             RowBox[{"vals", ",", "vecs"}], "}"}]}, "Transpose", SyntaxForm -> 
          SuperscriptBox], ",", "First"}], "]"}]},
    "Transpose"]}], ";", 
  RowBox[{
   RowBox[{"lorentzianKernel", "[", 
    RowBox[{"e_", ",", "e0_", ",", "eta_"}], "]"}], ":=", 
   FractionBox["eta", 
    RowBox[{"\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"e", "-", "e0"}], ")"}], "2"], "+", 
       SuperscriptBox["eta", "2"]}], ")"}]}]]}], ";", 
  RowBox[{
   RowBox[{"kLorentzianKernel", "[", 
    RowBox[{"dk_", ",", "etaK_"}], "]"}], ":=", 
   FractionBox["etaK", 
    RowBox[{"\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["dk", "2"], "+", 
       SuperscriptBox["etaK", "2"]}], ")"}]}]]}], ";", 
  RowBox[{
   RowBox[{"kDiskSamples", "[", 
    RowBox[{"k0_", ",", "kr_", ",", "kdens_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{"kr", "\[Equal]", "0"}], "]"}], ",", 
     RowBox[{"{", "k0", "}"}], ",", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"k0", "+", 
            RowBox[{"{", 
             RowBox[{"dx", ",", "dy"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"dx", ",", 
             RowBox[{"-", "kr"}], ",", "kr", ",", 
             FractionBox["kr", "kdens"]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"dy", ",", 
             RowBox[{"-", "kr"}], ",", "kr", ",", 
             FractionBox["kr", "kdens"]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"#1", "-", "k0"}], "]"}], "\[LessEqual]", "kr"}], "&"}]}], 
      "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"externalKPathIndex", "[", "kPath_", "]"}], ":=", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"Norm", "/@", 
       RowBox[{"Differences", "[", "kPath", "]"}]}], "]"}], ",", "0"}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"foldExternalK", "[", 
    RowBox[{"kExt_", ",", 
     RowBox[{"gList_", ":", "G"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "best", "}"}], ",", 
     RowBox[{
      RowBox[{"best", "=", 
       RowBox[{"First", "[", 
        RowBox[{"MinimalBy", "[", 
         RowBox[{
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"kExt", "-", "#1"}], "]"}], ",", 
               RowBox[{
               "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
                "#1"}], "}"}], "&"}], ",", "gList"}], "]"}], ",", "First"}], 
         "]"}], "]"}]}], ";", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<KFold\>\"", "\[Rule]", 
         RowBox[{"kExt", "-", 
          RowBox[{
          "best", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]}], 
        ",", 
        RowBox[{"\"\<GIndex\>\"", "\[Rule]", 
         RowBox[{
         "best", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"\"\<G\>\"", "\[Rule]", 
         RowBox[{
         "best", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"\"\<Distance\>\"", "\[Rule]", 
         RowBox[{
         "best", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
       "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"foldExternalKPath", "[", 
    RowBox[{"kExtPath_", ",", 
     RowBox[{"gList_", ":", "G"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fold", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"foldExternalK", "[", 
           RowBox[{"#1", ",", "gList"}], "]"}], "&"}], ")"}], "/@", 
        "kExtPath"}]}], "}"}], ",", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<KFoldPath\>\"", "\[Rule]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "[", "\"\<KFold\>\"", "]"}], "&"}], ")"}], "/@", 
         "fold"}]}], ",", 
       RowBox[{"\"\<GIndexPath\>\"", "\[Rule]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "[", "\"\<GIndex\>\"", "]"}], "&"}], ")"}], "/@", 
         "fold"}]}], ",", 
       RowBox[{"\"\<GPath\>\"", "\[Rule]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "[", "\"\<G\>\"", "]"}], "&"}], ")"}], "/@", 
         "fold"}]}], ",", 
       RowBox[{"\"\<FoldInfo\>\"", "\[Rule]", "fold"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"gSectorIndices", "[", 
    RowBox[{"gIndex_", ",", "blockSpec_List"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"blockSpec", "/.", "\[VeryThinSpace]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"offset_", ",", "blockDim_", ",", "subinds_"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"offset", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gIndex", "-", "1"}], ")"}], " ", "blockDim"}], "+", 
       "subinds"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedWeight", "[", 
    RowBox[{"vec_", ",", "gIndex_", ",", "blockSpec_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"inds", ",", "v", ",", "validInds", ",", "mask"}], "}"}], ",", 
     RowBox[{
      RowBox[{"inds", "=", 
       RowBox[{"gSectorIndices", "[", 
        RowBox[{"gIndex", ",", "blockSpec"}], "]"}]}], ";", 
      RowBox[{"v", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "vec", "]"}], "===", "SparseArray"}], ",", 
         RowBox[{"Normal", "[", "vec", "]"}], ",", "vec"}], "]"}]}], ";", 
      RowBox[{"validInds", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"inds", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerQ", "[", "#1", "]"}], "&&", 
           RowBox[{"1", "\[LessEqual]", "#1", "\[LessEqual]", 
            RowBox[{"Length", "[", "v", "]"}]}]}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "validInds", "]"}], "\[Equal]", "0"}], ",", 
        "0.`", ",", 
        RowBox[{
         RowBox[{"mask", "=", 
          RowBox[{"Normal", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{"validInds", "\[Rule]", "1.`"}], "]"}], ",", 
             RowBox[{"Length", "[", "v", "]"}]}], "]"}], "]"}]}], ";", 
         RowBox[{"Total", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"Abs", "[", "v", "]"}], "2"], " ", "mask"}], "]"}]}]}], 
       "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"eigensystemAtFoldedK", "[", 
    RowBox[{"hFun_", ",", "kFold_", ",", 
     RowBox[{"nEig_", ":", "All"}]}], "]"}], ":=", 
   RowBox[{"sortEigensystemByEnergy", "[", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"nEig", "===", "All"}], ",", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"hFun", "[", "kFold", "]"}], "]"}], ",", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{
        RowBox[{"hFun", "[", "kFold", "]"}], ",", "nEig"}], "]"}]}], "]"}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"shiftEigenvaluesByHalfFilling", "[", 
    RowBox[{"vals_", ",", 
     RowBox[{"shift_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "nOcc", "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "shift", "]"}], ",", 
       RowBox[{
        RowBox[{"nOcc", "=", 
         RowBox[{"Floor", "[", 
          FractionBox[
           RowBox[{"Length", "[", "vals", "]"}], "2"], "]"}]}], ";", 
        RowBox[{"vals", "-", 
         RowBox[{
         "vals", "\[LeftDoubleBracket]", "nOcc", 
          "\[RightDoubleBracket]"}]}]}], ",", 
       RowBox[{"NumericQ", "[", "shift", "]"}], ",", 
       RowBox[{"vals", "-", "shift"}], ",", "True", ",", "vals"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectrumAtAlignedK", "[", 
    RowBox[{
    "vals_", ",", "vecs_", ",", "gIndex_", ",", "eGrid_", ",", "eta_", ",", 
     "blockSpec_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "weights", "}"}], ",", 
     RowBox[{
      RowBox[{"weights", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"unfoldedWeight", "[", 
           RowBox[{"#1", ",", "gIndex", ",", "blockSpec"}], "]"}], "&"}], 
         ")"}], "/@", "vecs"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"weights", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"lorentzianKernel", "[", 
              RowBox[{"e", ",", "#1", ",", "eta"}], "]"}], "&"}], ")"}], "/@",
            "vals"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "eGrid"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectralDataAligned", "[", 
    RowBox[{
    "kExtPath_", ",", "evalsByK_", ",", "evecsByK_", ",", "gIndexPath_", ",", 
     "eGrid_", ",", "eta_", ",", "blockSpec_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"externalKPathIndex", "[", "kExtPath", "]"}]}], ",", 
       "spectra"}], "}"}], ",", 
     RowBox[{
      RowBox[{"spectra", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"unfoldedSpectrumAtAlignedK", "[", 
          RowBox[{
           RowBox[{
           "evalsByK", "\[LeftDoubleBracket]", "ik", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "evecsByK", "\[LeftDoubleBracket]", "ik", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "gIndexPath", "\[LeftDoubleBracket]", "ik", 
            "\[RightDoubleBracket]"}], ",", "eGrid", ",", "eta", ",", 
           "blockSpec"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ik", ",", 
           RowBox[{"Length", "[", "kExtPath", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "x", "\[LeftDoubleBracket]", "ik", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "eGrid", "\[LeftDoubleBracket]", "ie", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{"spectra", "\[LeftDoubleBracket]", 
             RowBox[{"ik", ",", "ie"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ik", ",", 
            RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ie", ",", 
            RowBox[{"Length", "[", "eGrid", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectralDensityPlotAligned", "[", 
    RowBox[{
    "kExtPath_", ",", "evalsByK_", ",", "evecsByK_", ",", "gIndexPath_", ",", 
     "eGrid_", ",", "eta_", ",", "blockSpec_List", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "ListDensityPlot", "]"}]}]}], "]"}], ":=", 
   RowBox[{"ListDensityPlot", "[", 
    RowBox[{
     RowBox[{"unfoldedSpectralDataAligned", "[", 
      RowBox[{
      "kExtPath", ",", "evalsByK", ",", "evecsByK", ",", "gIndexPath", ",", 
       "eGrid", ",", "eta", ",", "blockSpec"}], "]"}], ",", 
     RowBox[{"InterpolationOrder", "\[Rule]", "1"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<external k path\>\"", ",", "\"\<E\>\"", 
        ",", "\"\<A(k,E)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}], ",", "opts"}], "]"}]}], 
  ";", 
  RowBox[{
   RowBox[{"unfoldedSpectrumAtKWithKBroadening", "[", 
    RowBox[{
    "kExt_", ",", "hFun_", ",", "eGrid_", ",", "etaE_", ",", "etaK_", ",", 
     "kr_", ",", "kdens_", ",", "blockSpec_List", ",", 
     RowBox[{"gList_", ":", "G"}], ",", 
     RowBox[{"nEig_", ":", "All"}], ",", 
     RowBox[{"energyShift_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ksamples", ",", "normaliz", ",", "spectrum", ",", "fold", ",", "eig", ",",
        "vals", ",", "vecs", ",", "weights", ",", "weightK"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ksamples", "=", 
       RowBox[{"kDiskSamples", "[", 
        RowBox[{"kExt", ",", "kr", ",", "kdens"}], "]"}]}], ";", 
      RowBox[{"normaliz", "=", "0.`"}], ";", 
      RowBox[{"spectrum", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.`", ",", 
         RowBox[{"Length", "[", "eGrid", "]"}]}], "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"fold", "=", 
          RowBox[{"foldExternalK", "[", 
           RowBox[{"ksamp", ",", "gList"}], "]"}]}], ";", 
         RowBox[{"weightK", "=", 
          RowBox[{"kLorentzianKernel", "[", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"ksamp", "-", "kExt"}], "]"}], ",", "etaK"}], "]"}]}], ";", 
         RowBox[{"normaliz", "+=", "weightK"}], ";", 
         RowBox[{"eig", "=", 
          RowBox[{"eigensystemAtFoldedK", "[", 
           RowBox[{"hFun", ",", 
            RowBox[{"fold", "[", "\"\<KFold\>\"", "]"}], ",", "nEig"}], 
           "]"}]}], ";", 
         RowBox[{"vals", "=", 
          RowBox[{"shiftEigenvaluesByHalfFilling", "[", 
           RowBox[{
            RowBox[{
            "eig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
             "energyShift"}], "]"}]}], ";", 
         RowBox[{"vecs", "=", 
          RowBox[{
          "eig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";", 
         RowBox[{"weights", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"unfoldedWeight", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"fold", "[", "\"\<GIndex\>\"", "]"}], ",", 
               "blockSpec"}], "]"}], "&"}], ")"}], "/@", "vecs"}]}], ";", 
         RowBox[{"spectrum", "+=", 
          RowBox[{"weightK", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"weights", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"lorentzianKernel", "[", 
                   RowBox[{"e", ",", "#1", ",", "etaE"}], "]"}], "&"}], ")"}],
                 "/@", "vals"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"e", ",", "eGrid"}], "}"}]}], "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ksamp", ",", "ksamples"}], "}"}]}], "]"}], ";", 
      FractionBox["spectrum", "normaliz"]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectralDataKBroadening", "[", 
    RowBox[{
    "kExtPath_", ",", "hFun_", ",", "eGrid_", ",", "etaE_", ",", "etaK_", ",",
      "kr_", ",", "kdens_", ",", "blockSpec_List", ",", 
     RowBox[{"gList_", ":", "G"}], ",", 
     RowBox[{"nEig_", ":", "All"}], ",", 
     RowBox[{"energyShift_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"externalKPathIndex", "[", "kExtPath", "]"}]}], ",", 
       "spectra"}], "}"}], ",", 
     RowBox[{
      RowBox[{"spectra", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"unfoldedSpectrumAtKWithKBroadening", "[", 
          RowBox[{
           RowBox[{
           "kExtPath", "\[LeftDoubleBracket]", "ik", 
            "\[RightDoubleBracket]"}], ",", "hFun", ",", "eGrid", ",", "etaE",
            ",", "etaK", ",", "kr", ",", "kdens", ",", "blockSpec", ",", 
           "gList", ",", "nEig", ",", "energyShift"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ik", ",", 
           RowBox[{"Length", "[", "kExtPath", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "x", "\[LeftDoubleBracket]", "ik", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "eGrid", "\[LeftDoubleBracket]", "ie", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{"spectra", "\[LeftDoubleBracket]", 
             RowBox[{"ik", ",", "ie"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ik", ",", 
            RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ie", ",", 
            RowBox[{"Length", "[", "eGrid", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"unfoldedSpectralDensityPlotKBroadening", "[", 
    RowBox[{
    "kExtPath_", ",", "hFun_", ",", "eGrid_", ",", "etaE_", ",", "etaK_", ",",
      "kr_", ",", "kdens_", ",", "blockSpec_List", ",", 
