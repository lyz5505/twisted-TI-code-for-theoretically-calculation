           RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"INTDOT", "[", 
      RowBox[{"Append", "[", 
       RowBox[{"t", ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Tran2", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"t", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
