Cell[BoxData[
 RowBox[{
  RowBox[{"off", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Total", "@", "Glength"}], ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "13"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"G", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"mpairs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{"bb1", ",", "bb2"}], "}"}]}]}], "]"}], "<=", 
         RowBox[{
          RowBox[{"Norm", "[", "bb1", "]"}], "/", "100"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"off", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "13"}], "}"}]}], "]"}], ";"}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "mathemtica_code_yunzhe_new P4.nb", "OriginalInputIndex" -> 
   94, "EditNote" -> ""|>,
 CellTags->"Source:P4:94",
 CellLabel->
  "In[124]:=",ExpressionUUID->"1127b74c-2390-1446-9d7b-17829d9693bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hoffmoire", "=", 
   RowBox[{"Total", "@", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"off", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"couplingmatrixd0", "*", 
          RowBox[{"dd0CoeffMN", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "\[IndentingNewLine]", "+", 
         RowBox[{"couplingmatrixd1", "*", 
          RowBox[{"dd1CoeffMN", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "\[IndentingNewLine]", "+", 
         RowBox[{"couplingmatrixd3", "*", 
          RowBox[{"dd3CoeffMN", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "13"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "mathemtica_code_yunzhe_new P4.nb", "OriginalInputIndex" -> 
   98, "EditNote" -> ""|>,
 CellTags->"Source:P4:98",
 CellLabel->
  "In[125]:=",ExpressionUUID->"c8a1837c-82b8-af49-9932-4ac4fd5a0623"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"H3Int", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{"BlockDiagonalMatrix", "@", 
     RowBox[{"ParallelTable", "[", " ", 
      RowBox[{
       RowBox[{"HSOC3layer", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky"}], "}"}], "+", 
         RowBox[{"G", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], ";", 
  RowBox[{
   RowBox[{"H3diag", "[", 
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "@", 
     RowBox[{"Chop", "@", "H3Int"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kx", "->", "kxx"}], ",", 
      RowBox[{"ky", "->", "kyy"}]}], "}"}]}]}], ";", 
  RowBox[{"H1Int", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{"BlockDiagonalMatrix", "@", 
     RowBox[{"ParallelTable", "[", " ", 
      RowBox[{
       RowBox[{"HSOC1layer", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky"}], "}"}], "+", 
         RowBox[{"G", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], ";", 
  RowBox[{
   RowBox[{"H1diag", "[", 
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "@", 
     RowBox[{"Chop", "@", "H1Int"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kx", "->", "kxx"}], ",", 
      RowBox[{"ky", "->", "kyy"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H1nsocInt", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{"BlockDiagonalMatrix", "@", 
     RowBox[{"ParallelTable", "[", " ", 
      RowBox[{
       RowBox[{"HNonSOClayer", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky"}], "}"}], "+", 
         RowBox[{"G", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
