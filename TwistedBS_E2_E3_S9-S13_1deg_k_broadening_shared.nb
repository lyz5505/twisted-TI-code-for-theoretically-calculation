Cell[CellGroupData[{

Cell["\<\
5. E3: Interface Onsite Potential and Band Inversion at 1 Degree\
\>", "Section",ExpressionUUID->"7e1c23fa-c987-0046-a65c-201b91834231"],

Cell["\<\
Rebuild the original 3+1 model at 1 degree so that the choice of theta31 does \
not affect E3. The calculation uses Hallcp[k,1,mu,mu].\
\>", "Text",ExpressionUUID->"8dede719-fac7-d446-931b-c5f02888aca3"],

Cell["\<\
Note: Parameterize the twist angle and G-shell cutoff; retain the original \
calculation.\
\>", "Text",ExpressionUUID->"82568494-15e4-df47-a7c2-974e1d0e5f77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TA", "=", 
   RowBox[{"1", " ", "Degree"}]}], ";", 
  RowBox[{"bb1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b1"}], "*", "TA"}]}], ";", 
  RowBox[{"bb2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], ".", "b2"}], "*", "TA"}]}], ";", 
  RowBox[{"bb3", "=", 
   RowBox[{
    RowBox[{"RotationMatrix", "[", 
     RowBox[{"2", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb1"}]}], ";", 
  RowBox[{"bb4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb3"}], "//", "Chop"}]}], ";", 
  RowBox[{"bb5", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb4"}], "//", "Chop"}]}], ";", 
  RowBox[{"bb6", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], ".", "bb5"}], "//", "Chop"}]}], ";", 
  RowBox[{"n", "=", "moireShell"}], ";", 
  RowBox[{"Glength", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"2", "n"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"2", "n"}], ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Gbegin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "@", 
       RowBox[{"Glength", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "i"}], "]"}], "]"}]}], "-", 
      RowBox[{"Glength", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Glength", "]"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"G", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "i"}], ")"}], "bb5"}], "+", 
          RowBox[{"j", " ", "bb4"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "i"}], ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     ",", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "i"}], ")"}], "bb5"}], "+", 
          RowBox[{"j", " ", "bb4"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "n"}], ",", 
           RowBox[{"n", "-", "i"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{"Graphics", "[", 
   RowBox[{"Point", "[", "G", "]"}], "]"}]}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "mathemtica_code_yunzhe_new P4.nb", "OriginalInputIndex" -> 
   90, "EditNote" -> 
   "Parameterize the twist angle and G-shell cutoff; retain the original \
calculation."|>,
 CellTags->"Source:P4:90",
 CellLabel->
  "In[123]:=",ExpressionUUID->"e92729fd-d76e-6c4c-ae39-f007aec933df"],

