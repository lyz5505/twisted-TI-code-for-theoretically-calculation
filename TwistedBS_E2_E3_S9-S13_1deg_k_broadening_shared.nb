Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"P1", "=", 
    RowBox[{"ListDensityPlot", "[", 
     RowBox[{
      RowBox[{"dataByAngle2", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], ",", "\n",
       "  ", 
      RowBox[{"InterpolationOrder", " ", "->", " ", "1"}], ",", "\n", "  ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\>\"", ",", " ", "\"\<E(meV)\>\"", ",", 
         " ", "\"\<A(k,E)\>\""}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", 
      RowBox[{"ColorFunction", " ", "->", " ", "\"\<AvocadoColors\>\""}], ",", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", 
      RowBox[{"FrameTicks", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "\"\<0.1K\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"0.1", "K"}], "//", "Norm"}], 
               ",", "\"\<\[CapitalGamma]\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"dataByAngle2", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "1"}], "]"}], "]"}], "//", "Max"}], 
               ",", "\"\<0.1M\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", "\"\<\[CapitalGamma]\>\""}], "}"}]}], "}"}], ",",
            "Automatic"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "200"}], ",", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14"}], "]"}]}]}], "]"}]}], ";"}], 
