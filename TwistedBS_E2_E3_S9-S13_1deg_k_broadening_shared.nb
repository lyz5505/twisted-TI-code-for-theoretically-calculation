Cell[CellGroupData[{

Cell["\<\
8. S12: Original Weighted Averaging of Existing Angle-Resolved Spectra\
\>", "Section",ExpressionUUID->"9a086897-e455-134f-8e4c-5458cead5af8"],

Cell["\<\
This section reads existing spectra without calculating additional angles. It \
retains the original Transform1, Interpolation, p, and weighted sum. The \
Export cell that would overwrite average angle.csv is omitted.\
\>", "Text",ExpressionUUID->"fb60040f-c494-324a-8197-2e4fc9a8e152"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Transform1", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "80"}], ")"}], "/", "10"}], ",", "b"}], "}"}]}], ";", 
  RowBox[{"data", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       ",", "\"\<peakfit - Sheet1.csv\>\""}], "}"}], "]"}], "]"}]}], ";", 
  RowBox[{"bcClean", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Transform1", ",", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"2", ";;"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 254, 
   "EditNote" -> ""|>,
 CellTags->"Source:angle:254",
 CellLabel->
  "In[206]:=",ExpressionUUID->"2c9d6842-21a3-3146-a8ac-f128d54637c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"Interpolation", "[", "bcClean", "]"}]}], ";"}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 258, 
   "EditNote" -> ""|>,
 CellTags->"Source:angle:258",
 CellLabel->
  "In[207]:=",ExpressionUUID->"e4a2c094-c550-8941-a7d0-244e005253a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Totalp", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "15"}], "}"}]}], "]"}]}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 261, 
   "EditNote" -> ""|>,
 CellTags->"Source:angle:261",
 CellLabel->
  "In[208]:=",ExpressionUUID->"c10171ba-8645-0f49-9b8a-d17d30cfc130"],

Cell[BoxData["57687.42175015864`"], "Output",
 CellChangeTimes->{4.00114909479611*^9},
 CellTags->"Source:angle:261",
 CellLabel->
  "Out[208]=",ExpressionUUID->"0c1c952e-0f30-104d-9c01-c36e348f4ded"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", ">", "0"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"x", "-", "0.1"}], ",", "x"}], "}"}]}], "]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "x", ",", 
         RowBox[{"x", "+", "0.1"}]}], "}"}]}], "]"}]}], "]"}], "/", 
   "Totalp"}]}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 262, 
   "EditNote" -> ""|>,
 CellTags->"Source:angle:262",
 CellLabel->
  "In[209]:=",ExpressionUUID->"666937fb-8a9e-d245-b56d-d5001c487a05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"angleList", "=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"Reverse", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.1"}], " ", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "50"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"0.1", " ", "i"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "150"}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
