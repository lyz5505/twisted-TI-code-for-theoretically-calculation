Cell["Note: Set the averaging interval to -5 to 5 degrees.", "Text",ExpressionUUID->"1c16c95a-b82d-a449-8f8a-29c1cd9e542d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Totalp", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 261, 
   "EditNote" -> "Set the averaging interval to -5 to 5 degrees."|>,
 CellTags->"Source:angle:261",
 CellLabel->
  "In[216]:=",ExpressionUUID->"c9aee90a-182c-6548-8a89-2ccbcb9b44cb"],

Cell[BoxData["18100.007650495838`"], "Output",
 CellChangeTimes->{4.001149102971777*^9},
 CellTags->"Source:angle:261",
 CellLabel->
  "Out[216]=",ExpressionUUID->"ef0650b4-5dd1-f046-80be-77adbfd77909"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", ">", "0"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"x", "-", "0.1"}], ",", "x"}], "}"}]}], "]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "x", ",", 
         RowBox[{"x", "+", "0.1"}]}], "}"}]}], "]"}]}], "]"}], "/", 
   "Totalp"}]}]], "Input",
 TaggingRules-><|
  "OriginalFile" -> "angle depend.nb", "OriginalInputIndex" -> 262, 
   "EditNote" -> ""|>,
 CellTags->"Source:angle:262",
 CellLabel->
  "In[217]:=",ExpressionUUID->"e13e7eed-51e6-2d4c-be3f-7a473d7e7a0d"],

Cell["\<\
Note: Select existing CSV files from -5 to 5 degrees, retaining the original \
0.1-degree grid.\
\>", "Text",ExpressionUUID->"bfda0201-7bbe-9a4d-929c-b8853efcafcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"angleList", "=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"Reverse", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.1"}], " ", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "50"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
