Cell["\<\
Retain the eigenvalue indices from the original Gap2 cell. Replace the trial \
linear-layer-potential model Hallcpg with Hallcp[k,1,mu,mu] so that both gap \
curves use the same interface potential.\
\>", "Text",ExpressionUUID->"b3f5ef3d-876a-9144-a3cc-c0c978f41d25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Gap2", "[", "mu_", "]"}], ":=", 
   RowBox[{"Subtract", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Hallcp", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", "mu", ",", "mu"}], 
          "]"}], "+", 
         RowBox[{"1000", " ", 
          RowBox[{"IdentityMatrix", "[", "DimH", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          FractionBox["DimH", "2"], ",", 
          RowBox[{
           FractionBox["DimH", "2"], "+", "1"}]}], "}"}]}], "]"}], "-", 
      "1000"}], ")"}]}]}], ";", 
  RowBox[{"GAP2", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mu", ",", 
       RowBox[{"Gap2", "[", "mu", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"mu", ",", "0", ",", "30", ",", "0.1`"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"GAP", ",", "GAP2"}], "}"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<Delta E Gamma 1\>\"", ",", "\"\<Delta E Gamma 2\>\""}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellTags->"AssemblyAddition",
 CellLabel->
  "In[156]:=",ExpressionUUID->"202cd95f-1e83-214d-b692-69937ad66ff7"],

