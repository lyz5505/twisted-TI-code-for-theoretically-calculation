Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"P1", "=", 
    RowBox[{"ListDensityPlot", "[", 
     RowBox[{
      RowBox[{"dataByAngle2", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], ",", "\n",
       "  ", 
